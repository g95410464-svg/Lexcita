# Template only. No database has been created by this file.
APP_NAME=Lexcita
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Replace after Railway generates the web service's HTTPS address.
APP_URL=https://REPLACE-WITH-RAILWAY-HOST

ORGANIZATION_ISOLATED=true
ORGANIZATION_ID=servicios-legales-integrados
ORGANIZATION_NAME="Servicios Legales Integrados S.A. de C.V."
ORGANIZATION_DATABASE=lexcita_sli

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=lexcita_sli
DB_USERNAME=lexcita_sli_app
DB_PASSWORD=
DB_SSLMODE=require
# Do not copy the administrator DATABASE_URL into DB_URL.

SESSION_LIFETIME=120
SESSION_ENCRYPT=true
TRUST_RAILWAY_INGRESS=true
# Leave unset until Cloudflare injects X-Lexcita-Origin.
# CLOUDFLARE_ORIGIN_SECRET=

# Own Reverb application/credentials and queue worker for this organization.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
