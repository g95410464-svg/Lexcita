APP_NAME=tu_nombre_app_aqui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# ─── Base de datos MySQL ─────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tu_db_mysql_aqui
DB_USERNAME=tu_usuario_mysql_aqui
DB_PASSWORD=tu_password_mysql_aqui

# ─── Base de datos PostgreSQL ─────────────────────────────────
# Descomenta y configura estas variables si usas PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=tu_db_pgsql_aqui
# DB_USERNAME=tu_usuario_pgsql_aqui
# DB_PASSWORD=tu_password_pgsql_aqui

# ─── Sesiones ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ─── Stripe (Pagos) ──────────────────────────────────────────
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=tu_stripe_key_aqui
STRIPE_SECRET=tu_stripe_secret_aqui

# ─── Twilio (WhatsApp) ───────────────────────────────────────
# Regístrate en: https://www.twilio.com/try-twilio
# Sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=tu_twilio_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_twilio_auth_token_aqui
TWILIO_WHATSAPP_FROM=whatsapp:tu_numero_twilio_whatsapp_aqui

# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost/callback.php