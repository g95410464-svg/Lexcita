APP_NAME=tu_nombre_app_aqui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/El_Salvador

LOG_CHANNEL=stack

# ─── Base de datos MySQL ─────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tu_db_mysql_aqui
DB_USERNAME=tu_usuario_mysql_aqui
DB_PASSWORD=tu_password_mysql_aqui

# ─── Base de datos PostgreSQL ─────────────────────────────────
# Descomenta y configura estas variables si usas PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=tu_db_pgsql_aqui
# DB_USERNAME=tu_usuario_pgsql_aqui
# DB_PASSWORD=tu_password_pgsql_aqui

# ─── Sesiones ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Optional isolated deployment: one PostgreSQL database per organization.
# See docs/bases-por-organizacion.md before enabling.
ORGANIZATION_ISOLATED=false
# ORGANIZATION_ID=servicios-legales-integrados
# ORGANIZATION_NAME="Servicios Legales Integrados S.A. de C.V."
# ORGANIZATION_DATABASE=lexcita_sli

# HTTP abuse protection. Railway is detected by RAILWAY_ENVIRONMENT_ID.
# Set true only when every public request passes through Railway HTTP ingress.
# TRUST_RAILWAY_INGRESS=true
# Defaults to CACHE_STORE. Use a shared store (database or redis) with multiple replicas.
# RATE_LIMIT_STORE=redis
# Set only AFTER Cloudflare injects the same secret in X-Lexcita-Origin.
# CLOUDFLARE_ORIGIN_SECRET=

# ─── OTP por correo usando la API HTTPS de Brevo para SLI ───
# Genera una API key de Brevo (no la clave SMTP) y usa un remitente verificado.
BREVO_API_KEY=api_key_de_brevo
MAIL_FROM_ADDRESS=remitente-verificado@tudominio.com
MAIL_FROM_NAME="Servicios Legales Integrados"

# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# public: meet.jit.si requires moderator authentication. jaas: signed participant tokens.
JITSI_PROVIDER=public
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=

# ─── PayPal REST (Orders API v2) ─────────────────────────────
# Obtén las credenciales en https://developer.paypal.com/dashboard/
# PAYPAL_MODE=sandbox para pruebas; cambia a live solo en producción.
PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
PAYPAL_SECRET=tu_paypal_secret_aqui
PAYPAL_MODE=sandbox

# ─── Laravel Reverb (WebSockets) ──────────────────────────────
BROADCAST_DRIVER=reverb
REVERB_APP_ID=1
REVERB_APP_KEY=tu_reverb_app_key_aqui
REVERB_APP_SECRET=tu_reverb_app_secret_aqui
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Orígenes permitidos por Reverb, separados por coma.
# Producción: REVERB_ALLOWED_ORIGINS=https://tu-dominio-web
REVERB_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Públicas (van al navegador) — NUNCA incluir REVERB_APP_SECRET aquí
VITE_REVERB_APP_KEY=tu_reverb_app_key_aqui
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# SLI visual-editor uploads (private Railway S3-compatible bucket)
SLI_ASSETS_ACCESS_KEY_ID=
SLI_ASSETS_SECRET_ACCESS_KEY=
SLI_ASSETS_REGION=auto
SLI_ASSETS_BUCKET=
SLI_ASSETS_ENDPOINT=
SLI_ASSETS_USE_PATH_STYLE_ENDPOINT=false
